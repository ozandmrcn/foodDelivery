/* @file tsconfig.json — TypeScript configuration for the Auth service.
 * JSONC: comments are allowed here (NOT in package.json/nodemon.json).
 *
 * Every service compiles as an INDEPENDENT TS project (microservice rule again).
 *
 * Key flags:
 * - module/moduleResolution: nodenext -> native Node ESM.
 * - allowImportingTsExtensions + rewriteRelativeImportExtensions: imports keep
 *   ".ts" in the source and are rewritten to ".js" in the build output.
 * - verbatimModuleSyntax: forces `import type` for types (erased at build).
 * - isolatedModules / moduleDetection force: safe per-file building.
 * - strict + noUncheckedIndexedAccess + exactOptionalPropertyTypes: early bugs.
 * - skipLibCheck: faster builds, ignores node_modules .d.ts quirks.
 * - sourceMap/declaration/declarationMap: debugging + .d.ts output.
 */
{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext", // ES modules, Node's own resolution
    "moduleResolution": "nodenext",
    "target": "esnext", // newest JS output
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true, // .map files for debugging the built JS
    "declaration": true, // emit .d.ts type declarations
    "declarationMap": true, // map declarations back to sources

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true, // index access -> T | undefined
    "exactOptionalPropertyTypes": true, // optional props can't be set to undefined

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true, // master strict toggle
    "jsx": "react-jsx", // (not used here, but harmless)
    "verbatimModuleSyntax": true, // enforce `import type` for types
    "isolatedModules": true, // per-file transpilation safety
    "noUncheckedSideEffectImports": true, // flag side-effect imports that aren't modules
    "moduleDetection": "force", // every file is a module
    "allowImportingTsExtensions": true, // import "./x.ts" is legal
    "rewriteRelativeImportExtensions": true, // rewrites .ts -> .js in build output
    "skipLibCheck": true // skip node_modules .d.ts checking (fast builds)
  }
}