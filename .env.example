# ─── Gateway Service ────────────────────────────────────────────────────────
# Entry point that proxies all /api/* traffic to the internal services.
PORT=3000
AUTH_SERVICE_URL=http://localhost:3001
DELIVERY_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
RESTAURANTS_SERVICE_URL=http://localhost:3004

# ─── Auth Service ────────────────────────────────────────────────────────────
# Handles registration, login, JWT token issuance and user profiles.
PORT=3001
MONGODB_URI=mongodb://localhost:27017/food_delivery_auth
JWT_SECRET=your_super_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_here
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQ=100

# ─── Delivery Service ────────────────────────────────────────────────────────
# Manages couriers and consumes order events from RabbitMQ.
PORT=3002
MONGODB_URI=mongodb://localhost:27017/food_delivery_delivery
NODE_ENV=development
JWT_SECRET=your_super_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_here
RABBITMQ_URL=amqp://localhost:5672
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQ=100

# ─── Order Service ───────────────────────────────────────────────────────────
# Creates orders and publishes order.created events to RabbitMQ.
PORT=3003
MONGODB_URI=mongodb://localhost:27017/food_delivery_order
JWT_SECRET=your_super_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_here
RABBITMQ_URL=amqp://localhost:5672
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQ=100

# ─── Restaurant Service ──────────────────────────────────────────────────────
# Manages restaurants, menus and menu items.
PORT=3004
MONGODB_URI=mongodb://localhost:27017/food_delivery_restaurant
JWT_SECRET=your_super_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_here
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQ=100