                  "        console.log(\"🔑 Login successful. Token and UserId updated.\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"ozan@delivery.com\",\n    \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "### 🔑 User Login\nAuthenticates existing credentials and generates short-lived Access Token (1 hour) and Refresh Token (7 days).\n\n**Automated Script:** Sets `token`, `refreshToken`, and `userId` in collection variables."
          },
          "response": []
        },
