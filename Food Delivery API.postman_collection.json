                  "    pm.expect(res.result.data.accessToken).to.be.a('string');",
                  "    pm.expect(res.result.data.user.firstName).to.eql('TEST - Ozan');",
                  "    ",
                  "    pm.collectionVariables.set('token', res.result.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', res.result.data.refreshToken);",
                  "    pm.collectionVariables.set('userId', res.result.data.user.id);",
